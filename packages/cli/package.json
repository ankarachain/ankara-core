{
  "name": "@ankarachain/cli",
  "version": "0.0.1",
  "description": "Ankara Chain CLI — deploy RWA tokens from the command line",
  "type": "module",
  "bin": {
    "ankara": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ankarachain/sdk": "*",
    "chalk": "^5.3.0",
