    "dotenv": "^16.4.0",
    "ethers": "^6.11.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MIT",
  "author": "PIE Drops Studio <hello@piedrops.com>"
}
