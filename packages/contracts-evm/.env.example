# Copy to .env — NEVER commit .env to git

# Deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Alchemy API key — create app on Polygon Amoy at alchemy.com
ALCHEMY_API_KEY=your_alchemy_key_here

# Polygonscan API key — for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_key_here

# Celoscan API key — for contract verification on Celo mainnet
# (Celo Sepolia verifies via Blockscout and needs no key)
CELOSCAN_API_KEY=your_celoscan_key_here

# Set to "true" to enable gas cost reporting during tests
REPORT_GAS=false
