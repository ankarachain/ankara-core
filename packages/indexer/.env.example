# HTTP port the indexer's API listens on.
PORT=4100

# Where indexer.sqlite (events, webhooks, poll cursor) is stored. Point this
# at a mounted volume in any containerized deployment so it survives restarts.
DATA_DIR=./data

# Soroban RPC endpoint used to poll for contract events (NOT classic Horizon).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated Soroban contract IDs to index events for. Leave unset to
# auto-load every address from ../contracts-stellar/deployments.testnet.json
# instead (written by scripts/deploy-testnet.sh).
# INDEXER_CONTRACTS=CABC...,CDEF...

POLL_INTERVAL_MS=10000

# On first run (no saved cursor yet), how many ledgers back to start polling
# from. ~17280 ledgers is roughly 1 day at Stellar's ~5s ledger close time.
INITIAL_LEDGER_LOOKBACK=17280
