{
  "name": "@ankarachain/indexer",
  "version": "0.0.1",
  "description": "Ankara Chain event indexer — queryable index + webhook delivery for on-chain events, built for the Stellar side first",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "MIT",
  "author": "Cranebolt Technologies <hello@cranebolt.com>"
}
